{
  "name": "beso-de-cafe",
  "version": "0.1.0",
  "description": "Punto de venta y gestión interna - Beso de Café (aplicación de escritorio offline)",
  "author": "Beso de Café",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test.js",
    "reset-db": "node scripts/reset-db.js",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.besodecafe.pos",
    "productName": "Beso de Cafe",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
