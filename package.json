{
  "name": "beso-de-cafe",
  "version": "0.1.3",
  "description": "Punto de venta y gestión interna - Beso de Café (aplicación de escritorio offline)",
  "author": "Beso de Café",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test.js",
    "reset-db": "node scripts/reset-db.js",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder",
    "actualizacion": "node scripts/crear-actualizacion.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.besodecafe.pos",
    "productName": "Beso de Cafe",
    "asar": false,
    "files": [
      "src/**/*",
      "!src/renderer/marca/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Beso de Café"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "artifactName": "Beso-de-Cafe-Instalador-${version}.${ext}"
  }
}
